+/*
+ * Wait for LUN 0 to be ready. A unit attention clears on a retry; NOT READY
+ * (sense key 2) gets START STOP UNIT with START=1 on the LUN, then on the
+ * UFS Device well-known LUN (0xd0) with POWER CONDITION=ACTIVE, as Linux's
+ * ufshcd does after the bootloader. Neither touches the medium.
+ */
+static int
+ufs_unit_ready(void)
+{
+	static const uint8_t tur[6] = { 0x00 };
+	static const uint8_t ssu_start[6] = { 0x1b, 0, 0, 0, 0x01, 0 };
+	static const uint8_t ssu_active[6] = { 0x1b, 0, 0, 0, 0x10, 0 };
+	int error = EIO;
+
+	for (int i = 0; i < 10; i++) {
+		error = ufs_scsi(tur, sizeof(tur), 0, false);
+		if (!error) {
+			if (i) {
+				printf("SWEET UFS: LUN %u ready after %d retries\n", su.lun, i);
+			}
+			return 0;
+		}
+		if ((ufs_last_sense >> 16) == 0x2) {
+			if (i == 1) {
+				printf("SWEET UFS: LUN %u not ready: START STOP UNIT start=1\n", su.lun);
+				(void)ufs_scsi(ssu_start, sizeof(ssu_start), 0, false);
+			} else if (i == 3) {
+				uint8_t lun = su.lun;
+				printf("SWEET UFS: still not ready: device W-LUN power condition active\n");
+				su.lun = 0xd0;
+				(void)ufs_scsi(ssu_active, sizeof(ssu_active), 0, false);
+				su.lun = lun;
+			}
+		}
+		delay(20000);   /* 20 ms */
+	}
+	return error;
+}
