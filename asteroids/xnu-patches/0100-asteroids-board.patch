diff --git a/osfmk/arm64/arm_vm_init.c b/osfmk/arm64/arm_vm_init.c
index 06bb568..bb2326c 100644
--- a/osfmk/arm64/arm_vm_init.c
+++ b/osfmk/arm64/arm_vm_init.c
@@ -1828,8 +1828,9 @@ init_ptpages(tt_entry_t *tt, vm_map_address_t start, vm_map_address_t end, bool
 #if defined(SWEET)
 /*
  * The reserved low-globals/kernel region is excluded from VM allocation.
- * Use the otherwise empty 32MB block above low globals and below gVirtBase
- * for a Normal-NC framebuffer alias that survives bootstrap TTBR0 teardown.
+ * Use the otherwise empty 32MB blocks above low globals and below gVirtBase
+ * for a Normal-NC framebuffer alias that survives bootstrap TTBR0 teardown
+ * (SWEET_EARLY_FB_BLOCKS of them: the Phone (3a) splash crosses a block).
  */
 #define SWEET_EARLY_FB_VA (VM_MIN_KERNEL_ADDRESS + ARM_TT_L2_SIZE)
 
@@ -1837,16 +1838,23 @@ static void
 sweet_early_map_final(void)
 {
 	const vm_map_address_t va = SWEET_EARLY_FB_VA;
-	assert(va + ARM_TT_L2_SIZE <= gVirtBase);
+	_Static_assert(SWEET_EARLY_FB_BLOCK_SIZE == ARM_TT_L2_SIZE, "framebuffer blocks are L2 blocks");
+	assert(va + SWEET_EARLY_FB_BLOCKS * ARM_TT_L2_SIZE <= gVirtBase);
 	tt_entry_t l1 = cpu_tte[(va & ARM_TT_L1_INDEX_MASK) >> ARM_TT_L1_SHIFT];
 	assert((l1 & (ARM_TTE_VALID | ARM_TTE_TYPE_MASK)) == (ARM_TTE_VALID | ARM_TTE_TYPE_TABLE));
 	tt_entry_t *l2 = (tt_entry_t *)phystokv(l1 & ARM_TTE_TABLE_MASK);
-	tt_entry_t *slot = &l2[(va & ARM_TT_L2_INDEX_MASK) >> ARM_TT_L2_SHIFT];
-	assert(*slot == ARM_TTE_EMPTY);
-	*slot = 0x9c000000ULL | ARM_TTE_VALID | ARM_TTE_TYPE_BLOCK |
-	    ARM_TTE_BLOCK_SH(SH_OUTER_MEMORY) |
-	    ARM_TTE_BLOCK_ATTRINDX(CACHE_ATTRINDX_WRITECOMB) |
-	    ARM_TTE_BLOCK_AF | ARM_TTE_BLOCK_PNX | ARM_TTE_BLOCK_NX;
+	for (unsigned int i = 0; i < SWEET_EARLY_FB_BLOCKS; i++) {
+		vm_map_address_t bva = va + i * ARM_TT_L2_SIZE;
+		/* all blocks must sit in the same L2 table */
+		assert(((bva & ARM_TT_L1_INDEX_MASK) >> ARM_TT_L1_SHIFT) == ((va & ARM_TT_L1_INDEX_MASK) >> ARM_TT_L1_SHIFT));
+		tt_entry_t *slot = &l2[(bva & ARM_TT_L2_INDEX_MASK) >> ARM_TT_L2_SHIFT];
+		assert(*slot == ARM_TTE_EMPTY);
+		*slot = ((uint64_t)SWEET_EARLY_FB_BLOCK_PA + i * ARM_TT_L2_SIZE) |
+		    ARM_TTE_VALID | ARM_TTE_TYPE_BLOCK |
+		    ARM_TTE_BLOCK_SH(SH_OUTER_MEMORY) |
+		    ARM_TTE_BLOCK_ATTRINDX(CACHE_ATTRINDX_WRITECOMB) |
+		    ARM_TTE_BLOCK_AF | ARM_TTE_BLOCK_PNX | ARM_TTE_BLOCK_NX;
+	}
 	__asm__ volatile("dsb ishst" ::: "memory");
 }
 #endif
diff --git a/osfmk/arm64/start.s b/osfmk/arm64/start.s
index 023086f..241dd4a 100644
--- a/osfmk/arm64/start.s
+++ b/osfmk/arm64/start.s
@@ -515,10 +515,10 @@ LEXT(start_first_cpu)
 
 #if defined(SWEET)
 	/* Stage 0: white 64x32 band, no stack or page tables needed. */
-	MOV64	x0, (0x9c000000 + 2368 * 4320)
+	MOV64	x0, (SWEET_EARLY_FB_PA + (SWEET_EARLY_FB_HEIGHT - 32) * SWEET_EARLY_FB_STRIDE)
 	mov		w1, #-1
 	mov		x2, #32
-	mov		x4, #4320
+	mov		x4, #(SWEET_EARLY_FB_STRIDE)
 Lsweet_mark_row:
 	mov		x3, #64
 	mov		x5, x0
@@ -680,19 +680,25 @@ Lkernelcache_base_found:
 
 #if defined(SWEET)
 	/*
-	 * Splash framebuffer: one 32MB Normal-NC block in the EXISTING V=P
-	 * L2 table. Both framebuffer and RAM use L1 index 0; another call to
-	 * create_bootstrap_mapping would replace the RAM L2 table.
-	 * SWEET uses 16K pages and all bring-up RAM is below 4GB, so the first
-	 * V=P L2 page is bootstrap_pagetables + 2*PGBYTES.
+	 * Splash framebuffer: SWEET_EARLY_FB_BLOCKS 32MB Normal-NC blocks in the
+	 * EXISTING V=P L2 table. Framebuffer and RAM share L1 index 0 (a 16K L1
+	 * entry covers 64GB: sweet's RAM below 4GB, the Phone (3a)'s at
+	 * 0x8_c0000000); another create_bootstrap_mapping would replace the RAM
+	 * L2 table. The first V=P L2 page is bootstrap_pagetables + 2*PGBYTES.
 	 */
-	MOV64	x10, 0x9c000000
+	MOV64	x10, SWEET_EARLY_FB_BLOCK_PA
+	MOV64	x9, SWEET_EARLY_FB_BLOCK_SIZE		// too big for an add immediate
+	mov		x14, #(SWEET_EARLY_FB_BLOCKS)		// x9/x14 are free: common_start sets them first
+	add		x13, x25, #(2 * PGBYTES)
+Lsweet_fb_block:
 	MOV64	x11, (ARM_TTE_TYPE_BLOCK | ARM_TTE_VALID | ARM_TTE_BLOCK_SH(SH_OUTER_MEMORY) | ARM_TTE_BLOCK_ATTRINDX(CACHE_ATTRINDX_WRITECOMB) | ARM_TTE_BLOCK_AF | ARM_TTE_BLOCK_PNX | ARM_TTE_BLOCK_NX)
 	orr		x11, x11, x10
 	and		x12, x10, #(ARM_TT_L2_INDEX_MASK)
 	lsr		x12, x12, #(ARM_TT_L2_SHIFT)
-	add		x13, x25, #(2 * PGBYTES)
 	str		x11, [x13, x12, lsl #TTE_SHIFT]
+	add		x10, x10, x9
+	subs	x14, x14, #1
+	b.ne	Lsweet_fb_block
 #endif
 
 	/* Ensure TTEs are visible */
diff --git a/osfmk/arm64/sweet_early.c b/osfmk/arm64/sweet_early.c
index 6928957..5adc72e 100644
--- a/osfmk/arm64/sweet_early.c
+++ b/osfmk/arm64/sweet_early.c
@@ -1,5 +1,5 @@
 /*
- * Redmi Note 10 Pro bootstrap console. No allocation, locks, ADT parsing or
+ * SWEET bootstrap console (framebuffer from SWEET.h: sweet or Phone (3a)). No allocation, locks, ADT parsing or
  * per-CPU state: panic() can reach this before a current thread exists.
  * start.s maps the splash framebuffer VA=PA as Normal Non-Cacheable memory.
  * arm_vm_init installs a reserved kernel VA alias before removing TTBR0;
@@ -11,11 +11,11 @@
 #include <stdint.h>
 #include <kern/misc_protos.h>
 
-static volatile uint32_t *early_fb = (volatile uint32_t *)(uintptr_t)0x9c000000;
+static volatile uint32_t *early_fb = (volatile uint32_t *)(uintptr_t)SWEET_EARLY_FB_PA;
 #define EARLY_FB early_fb
-#define EARLY_WIDTH 1080u
-#define EARLY_HEIGHT 2400u
-#define EARLY_STRIDE (4320u / 4)
+#define EARLY_WIDTH ((unsigned int)SWEET_EARLY_FB_WIDTH)
+#define EARLY_HEIGHT ((unsigned int)SWEET_EARLY_FB_HEIGHT)
+#define EARLY_STRIDE ((unsigned int)SWEET_EARLY_FB_STRIDE / 4)
 #define EARLY_SCALE 2u
 #define EARLY_CELL_W (8u * EARLY_SCALE)
 #define EARLY_CELL_H (16u * EARLY_SCALE)
@@ -129,7 +129,8 @@ void
 sweet_early_relocate(uint64_t base)
 {
 	sweet_early_mark(8, "leaving bootstrap TTBR0");
-	early_fb = (volatile uint32_t *)(uintptr_t)base;
+	/* base maps SWEET_EARLY_FB_BLOCK_PA; the framebuffer may start inside it. */
+	early_fb = (volatile uint32_t *)(uintptr_t)(base + (SWEET_EARLY_FB_PA - SWEET_EARLY_FB_BLOCK_PA));
 	__asm__ volatile("dsb sy" ::: "memory");
 	sweet_early_mark(9, "kernel framebuffer VA live");
 }
diff --git a/pexpert/pexpert/arm64/SWEET.h b/pexpert/pexpert/arm64/SWEET.h
index b99c2f4..2570eea 100644
--- a/pexpert/pexpert/arm64/SWEET.h
+++ b/pexpert/pexpert/arm64/SWEET.h
@@ -17,6 +17,25 @@
 
 #define SWEET                     1
 
+/*
+ * Nothing Phone (3a) ("asteroids", SM7635) build of the SWEET kernel
+ * (asteroids/xnu-patches). Board values measured by the asteroids M1 probe.
+ */
+#define SWEET_ASTEROIDS           1
+
+/*
+ * ABL splash framebuffer: a8r8g8b8, used before the ADT-driven console.
+ * It crosses a 32MB boundary (0xe3940000..0xe431ad00), so the bootstrap
+ * and kernel aliases map SWEET_EARLY_FB_BLOCKS blocks.
+ */
+#define SWEET_EARLY_FB_PA         0xe3940000
+#define SWEET_EARLY_FB_WIDTH      1080
+#define SWEET_EARLY_FB_HEIGHT     2392
+#define SWEET_EARLY_FB_STRIDE     4320    // bytes
+#define SWEET_EARLY_FB_BLOCK_SIZE 0x2000000
+#define SWEET_EARLY_FB_BLOCK_PA   (SWEET_EARLY_FB_PA & ~(SWEET_EARLY_FB_BLOCK_SIZE - 1))
+#define SWEET_EARLY_FB_BLOCKS     2
+
 /*
  * All eight cores (six A55 + two A76) as one homogeneous SMP cluster:
  * cpus=N is clamped here. Same ISA level (ARMv8.2), 64-byte lines, PSCI
@@ -43,16 +62,21 @@
 #endif /* ! ASSEMBLER */
 
 /*
- * Qualcomm numbers the architected timer PPIs 1/2/3/0 (secure phys, phys,
- * virt, hyp) instead of the usual 13/14/11/10: the virtual timer XNU uses
- * (CNTV) is INTID 16 + 3 = 19.
+ * sweet's Qualcomm DT numbers the timer PPIs 1/2/3/0 (virtual = INTID 19);
+ * the Phone (3a) uses the usual PPI 11, INTID 27 (probe run 3). The ADT's
+ * /arm-io/gic virtual-timer-intid overrides this default.
  */
-#define SWEET_VTIMER_INTID        19
+#define SWEET_VTIMER_INTID        27
 #define SWEET_IPI_SGI             1       // SGI used for cross-CPU signals
 
 #define GIC_SPURIOUS_IRQ          1023    // IRQ no. for GIC spurious interrupt
 
-#define GICR_PE_SIZE              0x20000 // Size of each redistributor region
+/*
+ * Phone (3a): GICv4 redistributors, 0x40000 apart (RD, SGI, VLPI, reserved
+ * frames). Under Gunyah only 32-bit GIC accesses work: byte writes to
+ * GICR_IPRIORITYR aborted in probe run 2.
+ */
+#define GICR_PE_SIZE              0x40000 // Size of each redistributor region
 
 /* GICv3 register definitions; see GICv3 spec (Arm IHI 0069G) */
 #define GICD_CTLR                 0x0
