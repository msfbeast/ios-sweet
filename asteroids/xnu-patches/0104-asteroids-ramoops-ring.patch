diff --git a/osfmk/arm64/sweet_early.c b/osfmk/arm64/sweet_early.c
index 44c1e33..6418d47 100644
--- a/osfmk/arm64/sweet_early.c
+++ b/osfmk/arm64/sweet_early.c
@@ -42,12 +42,23 @@ extern unsigned char iso_font[256 * 16];
 #define RAMOOPS_SIG  0x43474244u        /* "DBGC", Linux PERSISTENT_RAM_SIG */
 #define RAMOOPS_DATA 12u
 #define RAMOOPS_CAP  (SWEET_EARLY_LOG_SIZE - RAMOOPS_DATA)
+/*
+ * ABL's `oem dmesg` only prints about the first 240 KB of the zone (first
+ * iOS boot, 2026-10-20), so keep the text inside RAMOOPS_SHOW: the first
+ * RAMOOPS_KEEP bytes (shim, early boot, root mount) stay; the rest is a
+ * ring. After every line a marker shows where the newest text ends: read
+ * the ring part as [after marker ... end] then [start of ring ... marker].
+ */
+#define RAMOOPS_SHOW 0x34000u           /* 208 KiB */
+#define RAMOOPS_KEEP 0x10000u           /* 64 KiB */
+static const char ramoops_mark[] = "\n=== asteroids ring: newest text above, oldest below ===\n";
 
 static volatile uint8_t *ramoops = (volatile uint8_t *)(uintptr_t)SWEET_EARLY_LOG_PA;
 static uint32_t ramoops_len;
 static unsigned int ramoops_open;
 static char ramoops_hold[64 * 1024];
 static uint32_t ramoops_held;
+static uint32_t ramoops_wraps;
 
 static void
 sweet_ramoops_publish(void)
@@ -64,7 +75,7 @@ sweet_ramoops_putc(char c)
 	if (!ramoops_open) {
 		volatile uint32_t *h = (volatile uint32_t *)ramoops;
 		ramoops_open = 1;
-		if (h[0] == RAMOOPS_SIG && h[2] < RAMOOPS_CAP / 2) {
+		if (h[0] == RAMOOPS_SIG && h[2] < RAMOOPS_KEEP) {
 			ramoops_len = h[2];     /* after the shim's lines */
 		} else {
 			h[0] = RAMOOPS_SIG;
@@ -77,11 +88,17 @@ sweet_ramoops_putc(char c)
 		}
 		return;
 	}
-	if (ramoops_len >= RAMOOPS_CAP) {
-		return;
+	if (ramoops_len >= RAMOOPS_SHOW) {
+		ramoops_len = RAMOOPS_KEEP;     /* wrap inside the part ABL prints */
+		ramoops_wraps++;
 	}
 	ramoops[RAMOOPS_DATA + ramoops_len++] = (uint8_t)c;
 	if (c == '\n') {
+		if (ramoops_wraps && ramoops_len + sizeof(ramoops_mark) - 1 <= RAMOOPS_SHOW) {
+			for (unsigned int i = 0; i < sizeof(ramoops_mark) - 1; i++) {
+				ramoops[RAMOOPS_DATA + ramoops_len + i] = (uint8_t)ramoops_mark[i];
+			}
+		}
 		sweet_ramoops_publish();
 	}
 }
