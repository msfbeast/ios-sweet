+/*
+ * "[ssss.mmm] " before every line, from the virtual counter (19.2 MHz on the
+ * Phone (3a); counts from SoC power-on, so ABL time is included). Readable
+ * before the timebase is set up, and costs no locks.
+ */
+static void
+sweet_ramoops_stamp(void)
+{
+	uint64_t ms = __builtin_arm_rsr64("CNTVCT_EL0") / 19200;
+	char buf[12];
+	int n = 0;
+	unsigned int s = (unsigned int)(ms / 1000), frac = (unsigned int)(ms % 1000);
+	buf[n++] = '[';
+	for (unsigned int d = 1000; d; d /= 10) {
+		buf[n++] = (char)('0' + (s / d) % 10);
+	}
+	buf[n++] = '.';
+	buf[n++] = (char)('0' + frac / 100);
+	buf[n++] = (char)('0' + (frac / 10) % 10);
+	buf[n++] = (char)('0' + frac % 10);
+	buf[n++] = ']';
+	for (int i = 0; i < n; i++) {
+		sweet_ramoops_putc(buf[i]);
+	}
+	sweet_ramoops_putc(' ');
+}
+
 void
 sweet_ramoops_write(const char *c, int size)
 {
 	for (int i = 0; i < size; i++) {
+		if (!ramoops_midline && c[i] != '\n') {
+			ramoops_midline = 1;
+			sweet_ramoops_stamp();
+		}
 		sweet_ramoops_putc(c[i]);
+		if (c[i] == '\n') {
+			ramoops_midline = 0;
+		}
 	}
 }
 
