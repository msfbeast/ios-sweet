@@ -24,6 +27,92 @@ static volatile uint32_t *early_fb = (volatile uint32_t *)(uintptr_t)SWEET_EARLY
 
 extern unsigned char iso_font[256 * 16];
 
+#if defined(SWEET_EARLY_LOG_PA)
+/*
+ * Phone (3a): copy of all console text in the ramoops console zone, read
+ * back with `fastboot oem dmesg` after a warm reset (Power + Vol-). The
+ * asteroids shim already wrote its own lines there in the same layout, so
+ * continue after them. Device memory: byte stores, header words aligned.
+ * Single writer for now (cpus=1); text past the zone end is dropped.
+ *
+ * `ramoops` is the VA=PA address until sweet_early_relocate() (bootstrap
+ * TTBR0 goes away), NULL until sweet_ramoops_map() (fbcon setup), then an
+ * ml_io_map() alias. While NULL, text waits in ramoops_hold.
+ */
+#define RAMOOPS_SIG  0x43474244u        /* "DBGC", Linux PERSISTENT_RAM_SIG */
+#define RAMOOPS_DATA 12u
+#define RAMOOPS_CAP  (SWEET_EARLY_LOG_SIZE - RAMOOPS_DATA)
+
+static volatile uint8_t *ramoops = (volatile uint8_t *)(uintptr_t)SWEET_EARLY_LOG_PA;
+static uint32_t ramoops_len;
+static unsigned int ramoops_open;
+static char ramoops_hold[64 * 1024];
+static uint32_t ramoops_held;
+
+static void
+sweet_ramoops_publish(void)
+{
+	volatile uint32_t *h = (volatile uint32_t *)ramoops;
+	h[1] = ramoops_len;     /* start: next write offset */
+	h[2] = ramoops_len;     /* size: bytes valid (ABL prints the whole zone anyway) */
+	__asm__ volatile("dsb sy" ::: "memory");
+}
+
+static void
+sweet_ramoops_putc(char c)
+{
+	if (!ramoops_open) {
+		volatile uint32_t *h = (volatile uint32_t *)ramoops;
+		ramoops_open = 1;
+		if (h[0] == RAMOOPS_SIG && h[2] < RAMOOPS_CAP / 2) {
+			ramoops_len = h[2];     /* after the shim's lines */
+		} else {
+			h[0] = RAMOOPS_SIG;
+			ramoops_len = 0;
+		}
+	}
+	if (ramoops == NULL) {
+		if (ramoops_held < sizeof(ramoops_hold)) {
+			ramoops_hold[ramoops_held++] = c;
+		}
+		return;
+	}
+	if (ramoops_len >= RAMOOPS_CAP) {
+		return;
+	}
+	ramoops[RAMOOPS_DATA + ramoops_len++] = (uint8_t)c;
+	if (c == '\n') {
+		sweet_ramoops_publish();
+	}
+}
+
+void
+sweet_ramoops_write(const char *c, int size)
+{
+	for (int i = 0; i < size; i++) {
+		sweet_ramoops_putc(c[i]);
+	}
+}
+
+/* Called from the fbcon setup (pexpert/arm/pe_serial.c), once ml_io_map works. */
+void
+sweet_ramoops_map(void)
+{
+	if (ramoops != NULL) {
+		return;
+	}
+	volatile uint8_t *va = (volatile uint8_t *)ml_io_map(SWEET_EARLY_LOG_PA, SWEET_EARLY_LOG_SIZE);
+	if (va == NULL) {
+		return;
+	}
+	ramoops = va;
+	uint32_t n = ramoops_held;
+	ramoops_held = 0;
+	sweet_ramoops_write(ramoops_hold, (int)n);
+	sweet_ramoops_write("[asteroids: ramoops remapped]\n", 30);
+}
+#endif
+
 /* Initialized data must remain writable until disable, including panics. */
