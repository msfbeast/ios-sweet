+/*
+ * Console mirror for `fastboot oem dmesg`: ABL prints the ramoops console
+ * zone (Linux pstore layout: u32 "DBGC", u32 start, u32 size, then text)
+ * after a warm reset. start.s maps its 32MB block VA=PA as Device memory
+ * (the block also holds Gunyah and boot carve-outs: no Normal mapping, no
+ * speculative reads). There is no kernel-VA room for a third alias block
+ * (virt_base = alias + 2 blocks), so between the TTBR0 teardown and the
+ * fbcon setup (ml_io_map) text is held in RAM, then flushed.
+ */
+#define SWEET_EARLY_LOG_PA        0x81f20000
+#define SWEET_EARLY_LOG_SIZE      0x200000
+#define SWEET_EARLY_LOG_BLOCK_PA  (SWEET_EARLY_LOG_PA & ~(SWEET_EARLY_FB_BLOCK_SIZE - 1))
+
